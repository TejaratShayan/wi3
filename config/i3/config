# i3 config — managed by ~/setup-i3-environment (edit here, it's symlinked)
# Mod = Alt (the Windows key is grabbed by Windows itself under WSL)
set $mod Mod1

font pango:DejaVu Sans Mono 10

floating_modifier $mod
tiling_drag modifier titlebar

# --- Apps -------------------------------------------------------------
bindsym $mod+Return exec alacritty || xterm -fa 'JetBrains Mono' -fs 10
bindsym $mod+d exec --no-startup-id rofi -show drun
bindsym $mod+Shift+d exec --no-startup-id rofi -show run
bindsym $mod+Ctrl+d exec --no-startup-id ~/.local/bin/rofi-sudo
bindsym $mod+Tab exec --no-startup-id rofi -show window
bindsym $mod+grave exec --no-startup-id rofi -show window
bindsym $mod+Shift+q kill

# --- Focus (vim keys + arrows) -----------------------------------------
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# --- Move windows ------------------------------------------------------
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# --- Layout ------------------------------------------------------------
bindsym $mod+b split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+F11 exec --no-startup-id ~/.local/bin/xephyr-fullscreen
# switch between i3 instances (start-i3 --split)
bindsym $mod+o exec --no-startup-id ~/.local/bin/i3-switch-instance next
bindsym $mod+Ctrl+Right exec --no-startup-id ~/.local/bin/i3-switch-instance next
bindsym $mod+Ctrl+Left exec --no-startup-id ~/.local/bin/i3-switch-instance prev
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

# --- Workspaces --------------------------------------------------------
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# --- i3 control --------------------------------------------------------
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec --no-startup-id ~/.local/bin/rofi-powermenu

# --- Resize mode -------------------------------------------------------
mode "resize" {
        bindsym h resize shrink width 10 px or 10 ppt
        bindsym j resize grow height 10 px or 10 ppt
        bindsym k resize shrink height 10 px or 10 ppt
        bindsym l resize grow width 10 px or 10 ppt
        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

# --- Input method: Persian / English (fcitx5) -----------------------------
exec_always --no-startup-id ~/.local/bin/fcitx5-launch

# --- Notifications (dunst) ----------------------------------------------
exec_always --no-startup-id ~/.local/bin/dunst-launch
bindsym $mod+n exec --no-startup-id dunstctl close
bindsym $mod+Shift+n exec --no-startup-id dunstctl close-all
bindsym $mod+Ctrl+n exec --no-startup-id ~/.local/bin/rofi-notifications
bindsym $mod+period exec --no-startup-id dunstctl context

# --- VPN (~/vless-tun.sh) -------------------------------------------------
bindsym $mod+Shift+v exec --no-startup-id ~/.local/bin/vpn toggle
bindsym $mod+Ctrl+v exec --no-startup-id ~/.local/bin/vpn menu
for_window [instance="vpn-tun"] floating enable, resize set 760 420, move position center

# --- Company VPN (openfortivpn) ----------------------------------------------
bindsym $mod+Shift+o exec --no-startup-id ~/.local/bin/fvpn toggle
bindsym $mod+Ctrl+o exec --no-startup-id ~/.local/bin/fvpn menu
for_window [instance="^fvpn-tun"] floating enable, resize set 760 420, move position center

# --- Screenshots -------------------------------------------------------
bindsym Print exec --no-startup-id ~/.local/bin/screenshot area
bindsym Shift+Print exec --no-startup-id ~/.local/bin/screenshot full
bindsym $mod+Print exec --no-startup-id ~/.local/bin/screenshot window
bindsym $mod+Shift+s exec --no-startup-id ~/.local/bin/screenshot menu
bindsym $mod+Ctrl+s exec --no-startup-id ~/.local/bin/screenshot annotate

# --- Wallpaper ---------------------------------------------------------
exec_always --no-startup-id ~/.local/bin/wallpaper restore
bindsym $mod+Shift+w exec --no-startup-id ~/.local/bin/wallpaper pick

# --- Bar (polybar) ------------------------------------------------------
exec_always --no-startup-id ~/.local/bin/polybar-launch

# --- Look (matches rofi / polybar colours) ----------------------------
default_border pixel 2
default_floating_border pixel 2
gaps inner 6
gaps outer 2
