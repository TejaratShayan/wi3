#!/usr/bin/env bash
# sudo askpass helper: masked password prompt in rofi.
# Used via SUDO_ASKPASS; sudo passes the prompt text as $1.
exec rofi -dmenu -password -p " ${1:-Password}" \
  -theme-str 'listview { enabled: false; } mode-switcher { enabled: false; } window { width: 420px; }' \
  </dev/null
